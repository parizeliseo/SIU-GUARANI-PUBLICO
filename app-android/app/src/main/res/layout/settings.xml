<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="20dp" android:paddingBottom="28dp"
        android:focusable="true" android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">

        <!-- ===== Encabezado ===== -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ajustes" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:textColor="@color/fg"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:layout_marginBottom="18dp"
            android:text="Tus cuentas de Guaraní, cada cuánto se revisan y cómo te avisa la app."
            android:textSize="14sp" android:textColor="@color/muted"/>

        <!-- ===== 1. Cuenta ===== -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/TarjetaTitulo" android:text="Cuenta" android:drawableStart="@drawable/ic_account"/>
                <TextView style="@style/TarjetaSub"
                    android:text="Podés tener una por institución o facultad, o más de un usuario en la misma. La app las revisa a todas."/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <Spinner android:id="@+id/accSpinner" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:background="@drawable/campo_lista" android:paddingStart="6dp" android:paddingEnd="40dp"
                        android:contentDescription="Cuenta elegida"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/accNew"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="10dp"
                        android:text="Nueva" app:icon="@drawable/ic_add" app:cornerRadius="12dp"/>
                </LinearLayout>
                <TextView android:id="@+id/setStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:background="@drawable/estado_fondo" android:padding="10dp"
                    android:drawableStart="@drawable/ic_sync" android:drawablePadding="10dp" app:drawableTint="@color/m_primary"
                    android:gravity="center_vertical" android:textSize="13sp" android:textColor="@color/fg"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 2. Datos de la cuenta ===== -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/TarjetaTitulo" android:text="Datos de la cuenta" android:drawableStart="@drawable/ic_school"/>
                <TextView style="@style/TarjetaSub" android:layout_marginBottom="2dp"
                    android:text="Elegí tu institución y poné el mismo usuario y contraseña con los que entrás a Guaraní."/>

                <TextView style="@style/Etiqueta" android:layout_marginTop="10dp" android:text="Dónde estudiás"/>
                <com.google.android.material.textfield.TextInputLayout style="@style/CampoLista"
                    android:hint="Institución o facultad" app:startIconDrawable="@drawable/ic_school"
                    app:helperText="Escribí parte del nombre: UTN, UNC, IUGNA…">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/setInst"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:completionThreshold="1" android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo"
                    android:hint="Dirección de SIU Guaraní" app:startIconDrawable="@drawable/ic_link"
                    app:helperText="Se completa al elegir la institución. Si no está, pegá la de tu Guaraní.">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/setUrl"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textUri" android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilCarrera" style="@style/Campo"
                    android:hint="Carrera o propuesta" app:startIconDrawable="@drawable/ic_book"
                    app:helperText="Se completa sola al leer Guaraní. Escribila solo si querés otro nombre.">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/setCarrera"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textCapSentences" android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo"
                    android:hint="Nombre de esta cuenta" app:startIconDrawable="@drawable/ic_label"
                    app:helperText="Cómo la vas a ver en la app. Ej.: UTN Sistemas, Diplomatura.">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/setName"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textCapSentences" android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>

                <View style="@style/Separador"/>
                <TextView style="@style/Etiqueta" android:text="Tu usuario de Guaraní"/>
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo"
                    android:hint="Usuario" app:startIconDrawable="@drawable/ic_person"
                    app:helperText="DNI, legajo o e-mail, según tu institución.">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/setUser"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:autofillHints="username"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo"
                    android:hint="Contraseña" app:startIconDrawable="@drawable/ic_lock" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/setPass"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:autofillHints="password"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/setSavePass"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:checked="true" android:textSize="15sp" android:textColor="@color/fg"
                    android:text="Guardar la contraseña en este teléfono"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="48dp" android:textSize="12.5sp" android:textColor="@color/muted"
                    android:lineSpacingMultiplier="1.12"
                    android:text="Queda cifrada en el teléfono y solo se envía a tu Guaraní. Así la app vuelve a entrar sola cuando la sesión vence."/>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp"
                    android:text="Guardar cuenta y revisar" android:textSize="15sp" app:icon="@drawable/ic_check" app:cornerRadius="14dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp" android:text="Borrar esta cuenta del teléfono"
                    android:textColor="@color/danger" app:icon="@drawable/ic_delete" app:iconTint="@color/danger"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 3. Revisiones ===== -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/TarjetaTitulo" android:text="Revisiones" android:drawableStart="@drawable/ic_schedule"/>
                <TextView style="@style/TarjetaSub" android:text="Valen para todas las cuentas. Los cambios se guardan solos."/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Revisar Guaraní cada" android:textSize="15sp" android:textColor="@color/fg"/>
                <Spinner android:id="@+id/setInterval" android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="8dp" android:layout_marginBottom="10dp"
                    android:background="@drawable/campo_lista" android:paddingStart="6dp" android:paddingEnd="40dp"
                    android:contentDescription="Frecuencia de revisión"/>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/setKeep" style="@style/Interruptor"
                    android:text="Mantener la sesión abierta" android:checked="true"/>
                <TextView style="@style/InterruptorAyuda"
                    android:text="Toca Guaraní cada 8 minutos para que la sesión no venza."/>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/setFixed" style="@style/Interruptor"
                    android:text="Vigilancia permanente" android:checked="false"/>
                <TextView style="@style/InterruptorAyuda"
                    android:text="Si los avisos llegan tarde: deja una notificación fija para que Android no cierre la app. Gasta un poco más de batería."/>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/setWifi" style="@style/Interruptor"
                    android:text="Revisar solo con Wi-Fi" android:checked="false"/>
                <TextView style="@style/InterruptorAyuda" android:text="Para no gastar datos móviles."/>

                <!-- Se guarda solo al tocar cada opción; el botón queda oculto por compatibilidad -->
                <Button android:id="@+id/btnGeneral" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:visibility="gone" android:text="Guardar"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 4. Avisos ===== -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/TarjetaTitulo" android:text="Avisos" android:drawableStart="@drawable/ic_bell"/>
                <TextView style="@style/TarjetaSub"
                    android:text="Calificaciones, plan de estudios, inscripciones, mesas, mensajes y encuestas se avisan siempre."/>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/setAll" style="@style/Interruptor"
                    android:text="Avisar también otros cambios" android:checked="true"/>
                <TextView style="@style/InterruptorAyuda" android:text="Datos personales, inasistencias y cualquier otra página."/>

                <View style="@style/Separador" android:layout_marginBottom="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTest" style="@style/FilaAccion"
                    android:text="Probar una notificación" app:icon="@drawable/ic_bell"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSound" style="@style/FilaAccion"
                    android:text="Sonido de las calificaciones" app:icon="@drawable/ic_volume"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBattery" style="@style/FilaAccion"
                    android:text="Permitir que funcione en segundo plano" app:icon="@drawable/ic_battery"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCheck" style="@style/FilaAccion"
                    android:text="Revisar todas las cuentas ahora" app:icon="@drawable/ic_sync"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 5. Avanzado ===== -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/TarjetaTitulo" android:text="Avanzado" android:drawableStart="@drawable/ic_list"/>
                <TextView style="@style/TarjetaSub"
                    android:text="Páginas de Guaraní que se revisan en la cuenta elegida. La lista se arma sola con tu menú."/>
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo" android:layout_marginTop="0dp"
                    android:hint="Páginas vigiladas (una por línea)" app:startIconDrawable="@drawable/ic_link">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/setPages"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textUri" android:minLines="3" android:maxLines="8" android:gravity="top"
                        android:textSize="12.5sp" android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPages" style="@style/FilaAccion"
                    android:layout_marginTop="6dp" android:text="Guardar páginas" app:icon="@drawable/ic_check"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReset" style="@style/FilaAccion"
                    android:text="Empezar de cero sin avisar" app:icon="@drawable/ic_history"/>
                <TextView style="@style/InterruptorAyuda" android:layout_marginStart="44dp" android:layout_marginEnd="0dp"
                    android:text="Vuelve a tomar la foto de Guaraní. Sirve si recibís avisos viejos o repetidos."/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Pie ===== -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:textSize="12sp" android:textColor="@color/muted"
            android:lineSpacingMultiplier="1.2"
            android:text="Guaraní al día · app libre y gratuita, hecha por un estudiante.\nNo es una aplicación oficial del SIU ni de ninguna institución.\ngithub.com/parizeliseo/SIU-GUARANI-PUBLICO"/>
    </LinearLayout>
</ScrollView>
