<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:id="@+id/root" android:orientation="vertical">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/dashSwipe"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <WebView android:id="@+id/dashWeb" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <WebView android:id="@+id/menuWeb" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>

        <LinearLayout android:id="@+id/webPane" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal"
                android:background="@color/brand" android:gravity="center_vertical">
                <ImageButton android:id="@+id/webBack" android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Atrás" app:tint="#FFFFFF"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/webTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#FFFFFF" android:textSize="15sp" android:singleLine="true" android:ellipsize="end" android:text="SIU Guaraní"/>
                    <TextView android:id="@+id/webSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#CFE3DA" android:textSize="11sp" android:singleLine="true" android:ellipsize="end"/>
                </LinearLayout>
                <ImageButton android:id="@+id/webPdf" android:layout_width="44dp" android:layout_height="48dp"
                    android:src="@drawable/ic_pdf" android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Guardar esta página como PDF" app:tint="#FFFFFF"/>
                <ImageButton android:id="@+id/webHome" android:layout_width="44dp" android:layout_height="48dp"
                    android:src="@drawable/ic_home" android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Inicio" app:tint="#FFFFFF"/>
                <ImageButton android:id="@+id/webReload" android:layout_width="44dp" android:layout_height="48dp"
                    android:src="@drawable/ic_reload" android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Recargar" app:tint="#FFFFFF"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/webProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:visibility="gone"/>
            <WebView android:id="@+id/guaraniWeb" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </LinearLayout>

        <include android:id="@+id/setPane" layout="@layout/settings" android:visibility="gone"/>
    </FrameLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="wrap_content"
        app:menu="@menu/nav" app:labelVisibilityMode="labeled"
        android:background="@color/card" app:itemTextAppearanceActive="@style/NavTexto"
        app:itemTextAppearanceInactive="@style/NavTexto"/>
</LinearLayout>
