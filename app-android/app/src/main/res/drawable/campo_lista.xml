<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de las listas desplegables: caja con borde redondeado y flecha a la derecha -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/m_outline"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="12dp" android:width="24dp" android:height="24dp">
        <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="@color/m_on_surface_variant" android:pathData="M7,10l5,5 5,-5z"/>
        </vector>
    </item>
</layer-list>
